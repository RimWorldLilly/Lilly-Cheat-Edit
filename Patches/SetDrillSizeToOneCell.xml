<?xml version="1.0" encoding="utf-8"?>
<Patch>
  <Operation Class="PatchOperationSequence">
    <operations>
      <!-- Ground Penetrating Scanner: 1x1 footprint and graphic -->
      <li Class="PatchOperationConditional">
        <xpath>Defs/ThingDef[defName="GroundPenetratingScanner"]/interactionCellOffset</xpath>
        <match Class="PatchOperationReplace">
          <xpath>Defs/ThingDef[defName="GroundPenetratingScanner"]/interactionCellOffset</xpath>
          <value>
            <interactionCellOffset>(0,0,1)</interactionCellOffset>
          </value>
        </match>
      </li>
      <li Class="PatchOperationConditional">
        <xpath>Defs/ThingDef[defName="GroundPenetratingScanner"]/size</xpath>
        <match Class="PatchOperationReplace">
          <xpath>Defs/ThingDef[defName="GroundPenetratingScanner"]/size</xpath>
          <value>
            <size>(1,1)</size>
          </value>
        </match>
      </li>
      <li Class="PatchOperationConditional">
        <xpath>Defs/ThingDef[defName="GroundPenetratingScanner"]/graphicData/drawSize</xpath>
        <match Class="PatchOperationReplace">
          <xpath>Defs/ThingDef[defName="GroundPenetratingScanner"]/graphicData/drawSize</xpath>
          <value>
            <drawSize>(1,1)</drawSize>
          </value>
        </match>
      </li>
      <!-- Allow operation under roofs. This is a ThingDef root-level field. -->
      <li Class="PatchOperationConditional">
        <xpath>Defs/ThingDef[defName="GroundPenetratingScanner"]/canBeUsedUnderRoof</xpath>
        <match Class="PatchOperationReplace">
          <xpath>Defs/ThingDef[defName="GroundPenetratingScanner"]/canBeUsedUnderRoof</xpath>
          <value>
            <canBeUsedUnderRoof>true</canBeUsedUnderRoof>
          </value>
        </match>
      </li>
      <!-- Remove special placement workers, if the def has them. -->
      <li Class="PatchOperationConditional">
        <xpath>Defs/ThingDef[defName="GroundPenetratingScanner"]/placeWorkers</xpath>
        <match Class="PatchOperationRemove">
          <xpath>Defs/ThingDef[defName="GroundPenetratingScanner"]/placeWorkers</xpath>
        </match>
      </li>
      <!-- Relax terrain affordance requirement to Light. -->
      <li Class="PatchOperationConditional">
        <xpath>Defs/ThingDef[defName="GroundPenetratingScanner"]/terrainAffordanceNeeded</xpath>
        <match Class="PatchOperationReplace">
          <xpath>Defs/ThingDef[defName="GroundPenetratingScanner"]/terrainAffordanceNeeded</xpath>
          <value>
            <terrainAffordanceNeeded>Light</terrainAffordanceNeeded>
          </value>
        </match>
      </li>

      <!-- Optional mod buildings: only patch a field when its target exists. -->
      <li Class="PatchOperationConditional">
        <xpath>Defs/ThingDef[defName="RH_RepairHub_Large"]/size</xpath>
